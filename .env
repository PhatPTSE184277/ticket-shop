# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3316
MYSQL_USER=root
MYSQL_PASSWORD=root1234
MYSQL_DATABASE=ticket-shop

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6319
REDIS_PASSWORD=123456
REDIS_DATABASE=0
REDIS_CONNECTION_POOL_SIZE=50
REDIS_CONNECTION_MINIMUM_IDLE_SIZE=10

# Redis Sentinel Extras
# REDIS_SENTINEL_MASTER_NAME=mymaster
# REDIS_SENTINEL_NODES=redis://127.0.0.1:26379,redis://127.0.0.1:26380,redis://127.0.0.1:26381

# MONITORING (PROMETHEUS, GRAFANA & EXPORTERS)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
NODE_EXPORTER_PORT=9100
MYSQL_EXPORTER_PORT=9104
REDIS_EXPORTER_PORT=9121

# ELK STACK
ELK_VERSION=7.17.25
ES_JAVA_OPTS=-Xmx256m -Xms256m
LS_JAVA_OPTS=-Xmx256m -Xms256m

ELASTICSEARCH_PORT=9200
ELASTICSEARCH_NODE_PORT=9300
KIBANA_PORT=5601

LOGSTASH_BEATS_PORT=5044
LOGSTASH_TCP_PORT=5033
LOGSTASH_UDP_PORT=5022
LOGSTASH_API_PORT=9600